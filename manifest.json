{
  "name": "topographic-chat-background",
  "description": "Adds a drifting topographic contour map behind the main chat content area.",
  "version": "1.0.0",
  "author": "RandomahhDev",
  "license": "MIT",
  "entry": "index.tsx",
  "type": "plugin",
  "settings": [
    {
      "key": "driftSpeed",
      "type": "slider",
      "label": "Drift Speed",
      "min": 0.0001,
      "max": 0.002,
      "step": 0.0001,
      "default": 0.00035
    },
    {
      "key": "contourDensity",
      "type": "slider",
      "label": "Contour Density",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "key": "lineOpacity",
      "type": "slider",
      "label": "Line Opacity",
      "min": 0.05,
      "max": 0.8,
      "step": 0.01,
      "default": 0.16
    },
    {
      "key": "lineColor",
      "type": "text",
      "label": "Line Color",
      "default": "rgba(255,255,255,0.15)"
    }
  ]
}
